<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 520 112" width="520" height="112" role="img" aria-labelledby="tl-t">
<title id="tl-t">TraceForm Analytics — The Architecture of Continuity</title>
<!--
  HORIZONTAL LOCKUP — site header, email signature

  Dial reduced to 112px height: 36 divisions instead of 60, two
  threads instead of three, two nodes instead of three. The reverse
  time vector is preserved — that is the part that carries meaning
  and it is the last thing to be simplified away.

  Threads are bounded inside the viewBox with clearance for the
  arrowheads. Both ends of the primary thread are marked; the
  secondary thread is left open so the bundle does not read as
  four arrows at small sizes.
-->
<defs>
  <linearGradient id="l-ring" x1="0" y1="1" x2="1" y2="0">
    <stop offset="0" stop-color="#1c5f57"/><stop offset="1" stop-color="#4fd6c1"/>
  </linearGradient>
  <linearGradient id="l-thread" x1="0" y1="1" x2="1" y2="0">
    <stop offset="0" stop-color="#1c5f57" stop-opacity="0.55"/>
    <stop offset="0.4" stop-color="#2f9e8f"/>
    <stop offset="1" stop-color="#7defd8"/>
  </linearGradient>

  <!--
    orient="auto-start-reverse" is the whole trick: without it the
    marker-start head points forward along the path, i.e. inward.
    refX places the tip of the head on the path endpoint.
  -->
  <marker id="tf-arrow-light" markerWidth="4.2" markerHeight="4.2"
          refX="5.6" refY="3" orient="auto-start-reverse"
          markerUnits="strokeWidth" viewBox="0 0 6 6">
    <path d="M0,0 L0,6 L6,3 z" fill="#7defd8"/>
  </marker>
  <marker id="tf-arrow-dark" markerWidth="4.2" markerHeight="4.2"
          refX="5.6" refY="3" orient="auto-start-reverse"
          markerUnits="strokeWidth" viewBox="0 0 6 6">
    <path d="M0,0 L0,6 L6,3 z" fill="#2f9e8f"/>
  </marker>
</defs>

